# Dfns Custody API
DFNS_API_URL=https://api.dfns.io
DFNS_APP_ID=
DFNS_API_TOKEN=
DFNS_CRED_ID=
DFNS_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----

# Salesforce OAuth (optional — falls back to mock data if not set)
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Production deployment
APP_ORIGIN=https://your-domain.up.railway.app
CORS_ORIGIN=https://your-domain.up.railway.app

# ─── Compliance providers (optional — app falls back to sandbox/demo) ───
# ComplyCube KYC (https://www.complycube.com) — sandbox keys work fine for demo
# If absent, server runs in demo mode with deterministic mock check results.
COMPLYCUBE_API_KEY=
COMPLYCUBE_BASE_URL=https://api.complycube.com/v1
KYC_DEMO_MODE=false

# Chainalysis Public Sanctions Screening (https://public.chainalysis.com)
# Free tier, requires request for API key.
# If absent, demo mode curates real OFAC SDN crypto addresses for testing
# (Tornado Cash, Lazarus Group, Garantex, Hydra Market).
CHAINALYSIS_API_KEY=

# ─── Chainlink Data Feeds (Ethereum mainnet oracles) ───
# Used to price crypto holdings in EUR for four-eyes threshold checks +
# AUM valuation. Reads from on-chain aggregators (no API key needed).
# Default: https://ethereum-rpc.publicnode.com (public, stable).
# For higher throughput: Alchemy / Infura with paid tier.
CHAINLINK_RPC_URL=https://ethereum-rpc.publicnode.com

# ─── Tracfin / ERMES declarant metadata ───
